* text=auto eol=lf

# Windows launchers need CRLF for cmd.exe / Windows PowerShell 5.1.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Keep binary assets binary.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.pdf binary
*.zip binary
